{{!
    @template proctoringpolicy_contract/verification

    Example context (json):
    {
        "valid": true,
        "invaliddesc": "",
        "documentcode": "DOC-SITE-00000001",
        "fullname": "Example User",
        "username": "example",
        "maskedidnumber": "***.***.***-00",
        "email": "example@example.com",
        "acceptancedate": "14 August 2026, 19:00",
        "ipaddress": "192.0.2.1",
        "exam": "Example quiz",
        "uniquehash": "abc123"
    }
}}

<div class="container py-4">
    <h2 class="mb-3">{{#str}}verification_page_title, proctoringpolicy_contract{{/str}}</h2>
    <p class="text-muted mb-4">{{#str}}verification_page_intro, proctoringpolicy_contract{{/str}}</p>

    {{^valid}}
        <div class="alert alert-danger">
            <h4 class="mb-2">{{#str}}verification_invalid_title, proctoringpolicy_contract{{/str}}</h4>
            <p class="mb-0">{{invaliddesc}}</p>
        </div>
    {{/valid}}

    {{#valid}}
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="badge text-bg-success mb-3" style="font-size:1rem;padding:0.5rem 0.85rem;">
                    {{#str}}verification_valid_badge, proctoringpolicy_contract{{/str}}
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-3">{{#str}}verification_code_label, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9">{{documentcode}}</dd>

                    <dt class="col-sm-3">{{#str}}pdf_full_name, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9">{{fullname}}</dd>

                    <dt class="col-sm-3">{{#str}}pdf_username, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9">
                        {{username}}{{#maskedidnumber}} | {{#str}}pdf_cpf, proctoringpolicy_contract{{/str}} {{maskedidnumber}}{{/maskedidnumber}}
                    </dd>

                    <dt class="col-sm-3">{{#str}}pdf_email, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9">{{email}}</dd>

                    <dt class="col-sm-3">{{#str}}pdf_acceptance_date, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9">{{acceptancedate}}</dd>

                    <dt class="col-sm-3">{{#str}}pdf_ip_address, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9">{{ipaddress}}</dd>

                    <dt class="col-sm-3">{{#str}}verification_exam, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9">{{exam}}</dd>

                    <dt class="col-sm-3">{{#str}}pdf_unique_hash, proctoringpolicy_contract{{/str}}</dt>
                    <dd class="col-sm-9 text-break">{{uniquehash}}</dd>
                </dl>
            </div>
        </div>
    {{/valid}}
</div>
