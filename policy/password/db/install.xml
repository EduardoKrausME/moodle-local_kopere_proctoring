<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/kopere_proctoring/policy/password/db"
       VERSION="2026011600"
       COMMENT="XMLDB file for proctoringpolicy_password">
    <TABLES>
        <TABLE NAME="local_kppassword_req" COMMENT="Password/approval requests for in-class exams">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Course id"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Course module id (quiz)"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Quiz attempt id"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="User id (student)"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" COMMENT="Request status (pending | approved | blocked)"/>
                <FIELD NAME="password" TYPE="char" LENGTH="4" NOTNULL="true" DEFAULT="00000000" COMMENT="Numeric 8-digit password"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Creation timestamp"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Last modification timestamp"/>
                <FIELD NAME="ip" TYPE="char" LENGTH="45" NOTNULL="false" DEFAULT="" COMMENT="Remote IP address"/>
                <FIELD NAME="useragent" TYPE="text" LENGTH="small" NOTNULL="false" COMMENT="User agent string"/>
                <FIELD NAME="browserinfo" TYPE="text" LENGTH="small" NOTNULL="false" COMMENT="JSON with browser details"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="cmid_attempt_user_uix" UNIQUE="true" FIELDS="cmid, attemptid, userid"/>
                <INDEX NAME="course_status_idx" UNIQUE="false" FIELDS="courseid, status"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_kppassword_attempt" COMMENT="Wrong password attempts for password gate">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Course module id (quiz)"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Quiz attempt id"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="User id (student)"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Timestamp of wrong attempt"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="cm_attempt_user_time_idx" UNIQUE="false" FIELDS="cmid, attemptid, userid, timecreated"/>
            </INDEXES>
        </TABLE>

    </TABLES>
</XMLDB>
