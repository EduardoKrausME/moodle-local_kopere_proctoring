{{!
    @template proctoringpolicy_password/password_quiz_pending

    Example context (json):
    {
        "hasrequests": true,
        "requestscount": 1,
        "requests": []
    }
}}

{{#hasrequests}}
    <div class="alert alert-warning kopere-password-quiz-pending mt-3 mb-3" data-region="kopere-password-quiz-pending">
        <strong>{{#str}}quiz_pending_title, proctoringpolicy_password{{/str}}</strong>
        <ul class="mb-0 mt-2">
            {{#requests}}
                <li>
                    <a href="{{{userurl}}}">{{{userfullname}}}</a>
                    <span class="text-muted">({{#str}}column_attempt, proctoringpolicy_password{{/str}} {{{attemptid}}})</span>
                    — <code>{{{password}}}</code>
                    <a href="{{{approveurl}}}" class="ml-2">{{#str}}action_approve, proctoringpolicy_password{{/str}}</a>
                </li>
            {{/requests}}
        </ul>
    </div>
{{/hasrequests}}
