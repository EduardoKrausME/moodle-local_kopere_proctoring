{{!
    @template proctoringpolicy_password/password_admin_table

    Example context (json):
    {
        "hasrequests": true,
        "requests": []
    }
}}

{{#hasrequests}}
    <table class="generaltable">
        <thead>
        <tr>
            <th>{{#str}}column_course, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_user, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_attempt, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_cmid, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_browser, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_ip, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_created, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_status, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_password, proctoringpolicy_password{{/str}}</th>
            <th>{{#str}}column_actions, proctoringpolicy_password{{/str}}</th>
        </tr>
        </thead>
        <tbody>
        {{#requests}}
            <tr>
                <td>
                    <a href="{{courseurl}}">{{coursefullname}}</a><br>
                    <small>{{courseshortname}}</small>
                </td>
                <td>{{userfullname}} ({{userid}})</td>
                <td>{{attemptid}}</td>
                <td>
                    {{#hascmurl}}<a href="{{cmurl}}">{{cmname}}</a>{{/hascmurl}}
                    {{^hascmurl}}{{cmname}}{{/hascmurl}}
                </td>
                <td><small>{{browserinfo}}</small></td>
                <td>{{ip}}</td>
                <td>{{timecreated}}</td>
                <td>{{status}}</td>
                <td><code>{{password}}</code></td>
                <td>
                    <a href="{{approveurl}}" class="btn btn-secondary">
                        {{#str}}action_approve, proctoringpolicy_password{{/str}}
                    </a>
                </td>
            </tr>
        {{/requests}}
        </tbody>
    </table>
{{/hasrequests}}

{{^hasrequests}}
    <p>{{#str}}admin_norequests, proctoringpolicy_password{{/str}}</p>
{{/hasrequests}}
