{{!
    @template proctoringpolicy_password/password_student

    Example context (json):
    {
        // Aqui tem que criar o context em inglês
    }
}}

<div class="kopere-password-policy" data-kppass="container">
    <div class="kopere-proctoring-header">
        <h3 class="kopere-proctoring-title">
            {{#str}}student_title, proctoringpolicy_password{{/str}}
        </h3>
    </div>

    <div data-kppass="status"></div>

    <p>{{#str}}student_enter_password, proctoringpolicy_password{{/str}}</p>

    <div class="kopere-proctoring-footer">
        <div class="d-flex align-items-center gap-2">
            <input type="text"
                   class="form-control"
                   maxlength="8"
                   data-kppass="password"
                   placeholder="{{#str}}student_password_label, proctoringpolicy_password{{/str}}"/>
            <button type="button"
                    class="btn btn-primary text-nowrap"
                    data-kppass="submit">
                {{#str}}student_submit_password, proctoringpolicy_password{{/str}}
            </button>
        </div>
    </div>
</div>
