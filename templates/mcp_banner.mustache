<aside class="mcp-promo" aria-labelledby="local_kopere_proctoring-mcp-title">
    <div class="mcp-promo__icon" aria-hidden="true">MCP</div>
    <div class="mcp-promo__content">
        <span class="mcp-promo__badge">{{#str}}mcp_banner_badge,local_kopere_proctoring{{/str}}</span>
        <h3 id="local_kopere_proctoring-mcp-title">{{#str}}mcp_banner_title,local_kopere_proctoring{{/str}}</h3>
        <p>{{#str}}mcp_banner_description,local_kopere_proctoring{{/str}}</p>
        <ul>
            <li>{{#str}}mcp_banner_benefit_discovery,local_kopere_proctoring{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_security,local_kopere_proctoring{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_control,local_kopere_proctoring{{/str}}</li>
        </ul>
        <a class="mcp-promo__link" href="https://eduardokrausme.github.io/moodle-local_mcp/"
           target="_blank" rel="noopener noreferrer">{{#str}}mcp_banner_cta,local_kopere_proctoring{{/str}} &#8599;</a>
    </div>
    <div class="mcp-promo__close">
        <button class="mcp-promo__dismiss" type="submit"
            formaction="{{mcp_banner_dismiss_url}}" formmethod="post" formnovalidate
            name="dismiss_mcp_banner" value="1"
            aria-label="{{#str}}mcp_banner_dismiss,local_kopere_proctoring{{/str}}"
            title="{{#str}}mcp_banner_dismiss,local_kopere_proctoring{{/str}}">&times;</button>
    </div>
</aside>
