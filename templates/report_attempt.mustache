{{!
    @template local_kopere_proctoring/report_attempt
    Example context (json):
    {
        "student": "Student", "attemptid": 30, "attemptnumber": 1,
        "state": "In progress", "blocked": "No", "blockedreason": "",
        "focuscount": 0, "fullscreencount": 0, "contractaccepted": "Yes",
        "total": 2, "events": [], "hasevents": false, "paging": "",
        "reporturl": "/local/kopere_proctoring/report.php?cmid=12"
    }
}}
<section class="local-kopere-proctoring-report-attempt">
    <a href="{{{reporturl}}}">{{#str}}report_back, local_kopere_proctoring{{/str}}</a>
    <h2>{{student}}</h2>
    <p>{{#str}}report_attempt, local_kopere_proctoring{{/str}}: {{attemptnumber}} ({{attemptid}})</p>
    <dl class="row">
        <dt class="col-sm-4">{{#str}}report_state, local_kopere_proctoring{{/str}}</dt>
        <dd class="col-sm-8">{{state}}</dd>
        <dt class="col-sm-4">{{#str}}report_blocked, local_kopere_proctoring{{/str}}</dt>
        <dd class="col-sm-8">{{blocked}} {{blockedreason}}</dd>
        <dt class="col-sm-4">{{#str}}report_focus, local_kopere_proctoring{{/str}}</dt>
        <dd class="col-sm-8">{{focuscount}}</dd>
        <dt class="col-sm-4">{{#str}}report_fullscreen, local_kopere_proctoring{{/str}}</dt>
        <dd class="col-sm-8">{{fullscreencount}}</dd>
        <dt class="col-sm-4">{{#str}}report_contract, local_kopere_proctoring{{/str}}</dt>
        <dd class="col-sm-8">{{contractaccepted}}</dd>
    </dl>
    <p>{{#str}}report_notice, local_kopere_proctoring{{/str}}</p>
    <h3>{{#str}}report_events, local_kopere_proctoring{{/str}} ({{total}})</h3>
    {{#hasevents}}
        <div class="table-responsive"><table class="table table-striped table-sm">
            <caption>{{#str}}report_evidence_caption, local_kopere_proctoring{{/str}}</caption>
            <thead><tr>
                <th scope="col">{{#str}}report_action, local_kopere_proctoring{{/str}}</th>
                <th scope="col">{{#str}}report_time, local_kopere_proctoring{{/str}}</th>
            </tr></thead>
            <tbody>{{#events}}<tr><td>{{action}}</td><td>{{time}}</td></tr>{{/events}}</tbody>
        </table></div>
    {{/hasevents}}
    {{^hasevents}}<p>{{#str}}report_noevents, local_kopere_proctoring{{/str}}</p>{{/hasevents}}
    {{{paging}}}
</section>
