{{!
    @template local_kopere_proctoring/user_data

    Example context (json):
    {
        "title": "Kopere Proctoring data for John Doe",
        "userpicture": "<img src=\"...\" alt=\"...\">",
        "userfullname": "John Doe",
        "summary_attempts": 3,
        "summary_contracts": 2,
        "summary_logs": 18,
        "hasattempts": true,
        "attempts": []
    }
}}

<div class="local-kopere-proctoring-userdata">
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center gap-3">
            <div>
                {{{userpicture}}}
            </div>
            <div>
                <h3 class="mb-1">{{{title}}}</h3>
                <div class="text-muted">{{{userfullname}}}</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="small text-muted">{{#str}}userdata_total_attempts, local_kopere_proctoring{{/str}}</div>
                    <div class="h2 mb-0">{{{summary_attempts}}}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="small text-muted">{{#str}}userdata_total_contracts, local_kopere_proctoring{{/str}}</div>
                    <div class="h2 mb-0">{{{summary_contracts}}}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="small text-muted">{{#str}}userdata_logs, local_kopere_proctoring{{/str}}</div>
                    <div class="h2 mb-0">{{{summary_logs}}}</div>
                </div>
            </div>
        </div>
    </div>

    {{#hasattempts}}
        {{#attempts}}
            <div class="card mb-4">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong>{{{coursename}}}</strong><br>
                        <a href="{{{quizurl}}}">{{{quizname}}}</a>
                    </div>
                    <div class="text-muted text-end">
                        {{#str}}userdata_attempt_label, local_kopere_proctoring{{/str}} #{{{attemptnumber}}}<br>
                        {{{attemptstate}}}
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-6 mb-3">
                            <h5>{{#str}}userdata_attempt_details, local_kopere_proctoring{{/str}}</h5>
                            <table class="table table-sm">
                                <tbody>
                                <tr>
                                    <th>{{#str}}userdata_attemptid, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{attemptid}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_activity, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{cmid}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_created, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{createdtime}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_started, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{timestart}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_finished, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{timefinish}}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="col-lg-6 mb-3">
                            <h5>{{#str}}userdata_contract_details, local_kopere_proctoring{{/str}}</h5>
                            <table class="table table-sm">
                                <tbody>
                                <tr>
                                    <th>{{#str}}userdata_contractaccepted, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{contractacceptedlabel}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_contracttime, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{contracttime}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_ip, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{contractip}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_useragent, local_kopere_proctoring{{/str}}</th>
                                    <td><small>{{{contractuseragent}}}</small></td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_screenresolution, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{contractscreenresolution}}}</td>
                                </tr>
                                <tr>
                                    <th>{{#str}}userdata_geo, local_kopere_proctoring{{/str}}</th>
                                    <td>{{{contractgeo}}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <h5>{{#str}}userdata_logs, local_kopere_proctoring{{/str}} ({{{logcount}}})</h5>

                        {{#haslogs}}
                            <div class="table-responsive">
                                <table class="table table-striped table-sm">
                                    <thead>
                                    <tr>
                                        <th>{{#str}}userdata_log_action, local_kopere_proctoring{{/str}}</th>
                                        <th>{{#str}}userdata_time, local_kopere_proctoring{{/str}}</th>
                                        <th>{{#str}}userdata_ip, local_kopere_proctoring{{/str}}</th>
                                        <th>{{#str}}userdata_screenresolution, local_kopere_proctoring{{/str}}</th>
                                        <th>{{#str}}userdata_useragent, local_kopere_proctoring{{/str}}</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {{#logs}}
                                        <tr>
                                            <td>{{{actionvalue}}}</td>
                                            <td>{{{time}}}</td>
                                            <td>{{{ip}}}</td>
                                            <td>{{{screenresolution}}}</td>
                                            <td><small>{{{useragent}}}</small></td>
                                        </tr>
                                    {{/logs}}
                                    </tbody>
                                </table>
                            </div>
                        {{/haslogs}}

                        {{^haslogs}}
                            <div class="alert alert-secondary mb-0">
                                {{#str}}userdata_nologs, local_kopere_proctoring{{/str}}
                            </div>
                        {{/haslogs}}
                    </div>
                </div>
            </div>
        {{/attempts}}
    {{/hasattempts}}

    {{^hasattempts}}
        <div class="alert alert-info">
            {{#str}}userdata_noattempts, local_kopere_proctoring{{/str}}
        </div>
    {{/hasattempts}}
</div>
