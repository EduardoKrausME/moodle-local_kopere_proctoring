{{!
    @template local_kopere_proctoring/admin_plugins

    Example context (json):
    {
    }
}}

<div class="alert alert-info">
    {{#str}}managekopere_proctoringplugins_desc, local_kopere_proctoring{{/str}}
</div>

<table id="localplugins" class="flexible table table-striped table-hover admintable generaltable">
    <tr>
        {{#headers}}
            <th class="header c0" scope="col">
                {{{.}}}
            </th>
        {{/headers}}
    </tr>

    {{#rows}}
        <tr>
            <td class="cell">
                {{{name}}}
            </td>
            <td class="cell">
                {{{statushtml}}}
            </td>
            <td class="cell">
                {{{actions}}}
            </td>
            <td class="cell">
                {{{version}}}
            </td>
            <td class="cell">
                {{{uninstall}}}
            </td>
        </tr>
    {{/rows}}
</table>
